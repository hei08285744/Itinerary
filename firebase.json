{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".firebase/**",
      ".git/**",
      ".vscode/**",
      "functions/**",
      "**/node_modules/**",
      "firestore.rules",
      "README.md"
    ],
    "cleanUrls": true
  }
}